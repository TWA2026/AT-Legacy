# Copy to .env for local work. On Slipway, add these on the service's Environment tab instead.

# Required
DATABASE_URL=postgres://user:password@localhost:5432/atlegacy
ADMIN_PASSWORD=choose-a-long-password

# Optional: turns on the AI review of each request
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5

# Optional: finder's fee percent applied to new quote links (default 5)
FEE_PERCENT=5

# Optional: the site's public address, used in links you copy from the dashboard
PUBLIC_URL=

# Optional: email yourself when a request or partner application arrives (Resend)
RESEND_API_KEY=
NOTIFY_FROM=
NOTIFY_TO=
