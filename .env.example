# Copy to .env for local work. On Slipway, add these on the service's Environment tab instead.

# Required
DATABASE_URL=postgres://user:password@localhost:5432/atlegacy

# Dashboard sign-in: use WorkOS (recommended) or a single password.
# With both WorkOS values set, the password is switched off.
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
ADMIN_EMAILS=you@example.com
ADMIN_PASSWORD=

# Optional: turns on the AI review of each request
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5

# Optional: finder's fee percent applied to new quote links (default 5)
FEE_PERCENT=5

# Recommended: the hub's public address, such as https://atlegacyservices.com.
# Used for the sign-in redirect, links you copy from the dashboard, and HTTPS-only cookies.
PUBLIC_URL=

# Optional: email yourself when a request or partner application arrives (Resend)
RESEND_API_KEY=
NOTIFY_FROM=
NOTIFY_TO=

# Only when the dashboard runs as its own service behind the host's sign-in wall.
# On the dashboard service: DASHBOARD_ONLY=1, ADMIN_SIGNIN=host, and its own https address.
# On the public site: just DASHBOARD_URL, so /admin redirects to the dashboard.
DASHBOARD_ONLY=
ADMIN_SIGNIN=
DASHBOARD_URL=
